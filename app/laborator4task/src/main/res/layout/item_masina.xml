<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="12dp" >

    <!-- rand 1: marca + model (stg) si rating (dr) -->
   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="horizontal"
       >
    <TextView
        android:id="@+id/tv_item_marca_model"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="18sp"
        tools:text="Audi A4"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        />
    <TextView
        android:id="@+id/tv_item_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="4.5/5"
        android:textColor="#FBC02D"
        android:textSize="16sp"
        android:textStyle="bold"

        />
</LinearLayout>

    <!-- rand 2: Preț, An Fabricație și Putere (CP) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <TextView
            android:id="@+id/tv_item_pret_an_putere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Preț: 15000 EUR | An: 2020 | Putere: 150 CP"
            android:textColor="#424242"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_combustibil_electrica"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Combustibil: Hibrid (Electrica: Da)"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_item_garantie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Garanție: Da"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_culoare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Culoare: Negru"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_item_itp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exp. ITP: 15/05/2026"
            android:textSize="13sp" />
    </LinearLayout>



</LinearLayout>