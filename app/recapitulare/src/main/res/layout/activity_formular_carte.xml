<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formular pt adaugarea unei carti noi"
            android:textSize="20sp"
            />

        <!-- 1. EditText titlu carte -->
        <EditText
            android:id="@+id/et_titlu_carte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Titlu carte"
            android:inputType="textPersonName"
        />


        <!-- 2. Seekbar nr pagini carte -->
        <TextView
            android:id="@+id/tv_nr_pagini_afisat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alege nr de pagini mai jos: "
            android:textStyle="bold"
            android:textSize="14sp"
            />
        <SeekBar
            android:id="@+id/sb_nr_pagini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="1"
            android:max="2000"

            />

        <!-- 3. checkbox are coperta dura cartea -->
        <CheckBox
            android:id="@+id/cb_are_coperta_dura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cartea are coperta dura? Bifati daca DA:"
            android:checked="true"
            />

        <!-- 4. Radiogroup format carte -->
        <RadioGroup
            android:id="@+id/rg_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
              <RadioButton
                  android:id="@+id/rb_format_fizic"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Fizic"
                  android:checked="true"
                  />
              <RadioButton
                  android:id="@+id/rb_format_ebook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-book"/>
              <RadioButton
                  android:id="@+id/rb_format_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio"/>
        </RadioGroup>

        <!-- 5. Spinner Gen -->
        <!-- ==dropdown menu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecteaza genul cartii din lista de mai jos"
            android:textStyle="bold"
            android:textSize="14sp"
            />
        <Spinner
            android:id="@+id/spn_gen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />


        <!-- 6. ratingbar rating carte -->
        <RatingBar
            android:id="@+id/rb_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            />

        <!-- 7. switch eimprumutata -->
        <Switch
            android:id="@+id/sw_e_imprumutata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cartea e imprumutata? Bifati daca DA:"
            android:textSize="14sp"
            android:textStyle="bold"
            />

        <Button
            android:id="@+id/btn_salveaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salveaza"
            android:textSize="14sp"
            android:textStyle="bold"
            />

    </LinearLayout>



</ScrollView>